<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp"
    android:background="@drawable/voice_hud_card">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <com.eon.assistant.VoiceHudTrack android:id="@+id/floating_track"
            android:layout_width="24dp" android:layout_height="16dp"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/floating_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:maxWidth="140dp"
            android:maxLines="3" android:ellipsize="end"
            android:textSize="12sp" android:textColor="#13292D" />
    </LinearLayout>
    <com.eon.assistant.ToneGraph android:id="@+id/floating_meter"
        android:layout_width="match_parent" android:layout_height="18dp"
        android:background="#DFEBE9" android:visibility="gone" android:importantForAccessibility="no" />
</LinearLayout>
