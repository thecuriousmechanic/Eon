<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.eon.assistant" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:name=".FoundationVaultApplication"
        android:label="EON" android:allowBackup="false"
        android:extractNativeLibs="false" android:theme="@android:style/Theme.Material.Light">
        <activity android:name=".AssistantActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ProfileActionActivity" android:exported="false"
            android:enabled="@bool/voice_hud_supported" android:noHistory="true"
            android:excludeFromRecents="true" />
        <activity android:name=".ProjectionGrantActivity" android:exported="false"
            android:launchMode="singleTask" android:taskAffinity="com.eon.assistant.grant"
            android:enabled="@bool/projection_grant_supported" />
        <service android:name=".ProjectionGrantService" android:exported="false"
            android:enabled="@bool/projection_grant_supported" android:stopWithTask="true"
            android:foregroundServiceType="mediaProjection" />
        <activity android:name=".InspectionResultActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true"
            android:taskAffinity="com.eon.assistant.inspection" />
        <activity android:name=".FloatingHudActivity" android:exported="false"
            android:enabled="@bool/voice_hud_supported" />
        <service android:name=".FloatingHudService" android:exported="false"
            android:enabled="@bool/voice_hud_supported" android:stopWithTask="true"
            android:foregroundServiceType="specialUse|microphone">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started, read-only floating status card; optional six-second microphone meter; no screen inspection" />
        </service>
        <activity android:name=".DemoActionActivity" android:exported="false"
            android:enabled="@bool/focused_control_supported" android:noHistory="true" />
        <service android:name=".EonVoiceInteractionService" android:exported="true"
            android:enabled="@bool/voice_hud_supported" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction" />
        </service>
        <service android:name=".EonVoiceSessionService" android:exported="true"
            android:enabled="@bool/voice_hud_supported" android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".FocusedControlService" android:exported="true"
            android:enabled="@bool/focused_control_supported" android:label="@string/inspector_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/focused_control_service" />
        </service>
    </application>
</manifest>
