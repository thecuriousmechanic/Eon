# @case list-mutator-result
def collect_word(words: list, item: str):
    words = words.append(item.strip())
    return words
# @case shared-omitted-argument
def log_place(place, history=[]):
    history.append(place)
    return history
# @case repeated-row-alias
def grid(width, height):
    return [[0] * width] * height
# @case dictionary-pair-iteration
def legend(colors: dict[str, int]):
    return [f"{name}:{code}" for name, code in colors]
# @case literal-identity
def is_header(tag: str):
    return tag is "chapter"
# @case truthy-disjunction
def is_weekend(day):
    return day == "Sat" or "Sun"
# @case uncalled-text-predicate
def digits_only(text: str):
    if text.isdecimal:
        return text
    return ""
# @case late-closure-binding
def offsets(values):
    return [lambda: value + 1 for value in values]
# @case exception-disjunction
def lookup(row, key):
    try:
        return row[key]
    except KeyError or IndexError:
        return None
# @case generator-list-contract
def readings(values) -> list:
    return (v * 2 for v in values if v >= 0)
# @case tuple-assertion
def normalized(score):
    assert (0 <= score <= 100, "score outside percentage range")
    return score / 100
# @case missing-interpolation
def shelf_label(section, number):
    return "{section}-{number}"
